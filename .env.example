# Backend settings for running outside GCP (tests or a local API).
# Copy to .env, then from backend/app: uv run --env-file ../../.env <command>
# Production settings come from GitHub Actions secrets, see ops/gcp/README.md.

SERVER_NAME=localhost
SERVER_HOST=http://localhost:8000
PROJECT_NAME=NumerBay
SECRET_KEY=change-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Mailgun and Sentry are left unset so emails are skipped and errors stay local.
GCP_STORAGE_BUCKET=storage.test.numerbay.ai
WEBHOOK_ENABLED=False
